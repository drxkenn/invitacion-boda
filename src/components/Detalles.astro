---
// src/components/Detalles.astro
---

<!-- Volvemos al fondo beige un poco más oscuro para contrastar con las tarjetas blancas -->
<section class="py-20 px-6 bg-[#ece4d8]">
    <div class="max-w-md mx-auto space-y-8">
      
      <!-- Tarjeta 1: Ubicación -->
      <div class="bg-[#faf8f5] p-10 rounded-2xl shadow-xl text-center flex flex-col items-center">
          
          <!-- Icono de Mapa Minimalista -->
          <div class="text-[#7a2021] mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                  <circle cx="12" cy="10" r="3"/>
              </svg>
          </div>
  
          <h3 class="text-3xl text-[#2c2825] mb-3" style="font-family: 'Cormorant Garamond', serif;">
              Ubicación
          </h3>
          
          <p class="text-stone-600 mb-8 text-sm leading-relaxed">
              La ceremonia y recepción se llevarán a cabo en <br>
              <span class="font-medium text-[#2c2825]">Centro Turístico La Perla de Huaral</span><br>
              Lima, Huaral.
          </p>
  
          <!-- Botón a Google Maps -->
          <a 
              href="https://maps.app.goo.gl/vVK3UCuZA7SpXCzX9" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-block bg-[#7a2021] text-[#faf8f5] px-8 py-3 rounded-full uppercase tracking-[0.2em] text-xs hover:bg-[#5a1718] hover:scale-105 transition-all duration-300 shadow-md"
          >
              Ver en mapa
          </a>
      </div> 
    </div>
</section>