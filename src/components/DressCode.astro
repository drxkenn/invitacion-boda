---
// src/components/DressCode.astro
---

<section class="py-16 px-6 bg-[#faf8f5] text-center">
    <div class="max-w-md mx-auto flex flex-col items-center">
        
        <!-- Símbolo decorativo -->
        <span class="text-[#7a2021]/60 text-2xl mb-4">✦</span>

        <h2 class="text-3xl text-[#2c2825] mb-2" style="font-family: 'Cormorant Garamond', serif;">
            Código de Vestimenta
        </h2>
        
        <!-- Nivel de formalidad -->
        <p class="text-[#7a2021] font-medium tracking-[0.2em] uppercase text-xs mb-6">
            Formal / Elegante
        </p>
        
        <!-- Texto descriptivo -->
        <p class="text-stone-600 text-sm leading-relaxed max-w-[280px]">
            Nos encantaría verlos lucir sus mejores trajes y vestidos para celebrar con nosotros.
        </p>

        <!-- Nota aclaratoria (opcional) -->
        <p class="text-[#2c2825] text-sm mt-4 italic" style="font-family: 'Cormorant Garamond', serif;">
            Por favor, reserven el color blanco para la novia.
        </p>

    </div>
</section>