---
// src/pages/index.astro
import '../styles/global.css';

const siteURL = "https://invitacion-boda-one-vert.vercel.app/invitacion"; 
---

<html lang="es">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	
	<!-- Título y Descripción estándar -->
	<title>Nuestra Boda - Anahara & Julio</title>
	<meta name="description" content="Juntos en este gran camino, queremos compartir contigo un momento muy especial. ¡Acompáñanos este 17 de Octubre!" />

	<!-- Etiquetas Open Graph para previsualización en WhatsApp y Redes Sociales -->
	<meta property="og:type" content="website" />
	<meta property="og:url" content={siteURL} />
	<meta property="og:title" content="Nuestra Boda - Anahara & Julio 💍" />
	<meta property="og:description" content="Estás invitado a compartir este momento tan especial. Pulsa aquí para abrir la invitación." />
	
	<!-- LA IMAGEN: Debe ser una URL completa. Usamos la misma portada que ya tienes -->
	<meta property="og:image" content={`${siteURL}/portada-boda.png`} />
	<!-- Es buena práctica definir el tamaño recomendado por WhatsApp (opcional pero ayuda) -->
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />

</head>
<!-- Usamos un fondo ligeramente más oscuro para que la tarjeta blanca/beige resalte -->
<body class="bg-[#e4ddd3] min-h-[100dvh] flex items-center justify-center m-0 p-4 md:p-6 font-sans">
	
	<!-- 
		w-[92%] o w-[95%]: Deja un pequeño margen a los lados en celular.
		rounded-2xl y shadow-2xl: Ahora se aplican siempre, creando el efecto de tarjeta.
	-->
	<main class="relative w-[95%] max-w-[650px] rounded-2xl overflow-hidden shadow-2xl">
		
		<img 
			src="/portada-boda.png" 
			alt="Portada Invitación Boda" 
			class="w-full h-auto block"
		/>

		<!-- El hotspot vuelve a estar perfectamente calibrado -->
		<a 
			href="/invitacion" 
			class="absolute block top-[71.5%] left-[32%] w-[36%] h-[10%] rounded-full hover:scale-105 hover:bg-white/20 transition-all duration-300 ease-out cursor-pointer"
			aria-label="Abrir invitación"
		>
		</a>

	</main>

</body>
</html>