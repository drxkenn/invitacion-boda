---
// src/pages/index.astro
import '../styles/global.css';

const siteURL = "https://invitacion-boda-one-vert.vercel.app/invitacion"; 
---

<html lang="es">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	
	<!-- Título y Descripción estándar -->
	<title>Nuestra Boda - Anahara & Julio</title>
	<meta name="description" content="Juntos en este gran camino, queremos compartir contigo un momento muy especial. ¡Acompáñanos este 17 de Octubre!" />

	<!-- Etiquetas Open Graph para previsualización en WhatsApp y Redes Sociales -->
	<meta property="og:type" content="website" />
	<meta property="og:url" content={siteURL} />
	<meta property="og:title" content="Nuestra Boda - Anahara & Julio 💍" />
	<meta property="og:description" content="Estás invitado a compartir este momento tan especial. Pulsa aquí para abrir la invitación." />
	
	<!-- LA IMAGEN: Debe ser una URL completa. Usamos la misma portada que ya tienes -->
	<meta property="og:image" content={`${siteURL}/portada-boda.png`} />
	<!-- Es buena práctica definir el tamaño recomendado por WhatsApp (opcional pero ayuda) -->
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />

</head>
<!-- Añadimos overflow-hidden para evitar scroll lateral en celular -->
<body class="bg-[#e7e1d5] min-h-[100dvh] flex items-center justify-center m-0 md:p-6 font-sans overflow-hidden">
	
	<!-- main ahora ocupa el 100% del ALTO en móvil (h-[100dvh]) y centra el contenido -->
	<main class="relative w-full h-[100dvh] md:h-auto max-w-[650px] md:rounded-2xl overflow-hidden md:shadow-2xl flex justify-center items-center">
		
		<!-- Wrapper interno: fuerza que el contenido mantenga sus proporciones intactas -->
		<div class="relative h-full w-auto md:w-full flex-shrink-0 flex justify-center">
			
			<img 
				src="/portada-boda.png" 
				alt="Portada Invitación Boda" 
				class="h-full w-auto max-w-none md:w-full md:h-auto block"
			/>

			<!-- El hotspot sigue funcionando perfecto porque se posiciona según el wrapper interno -->
			<a 
				href="/invitacion" 
				class="absolute block top-[71.5%] left-[32%] w-[36%] h-[10%] rounded-full hover:scale-105 hover:bg-white/20 transition-all duration-300 ease-out cursor-pointer"
				aria-label="Abrir invitación"
			>
			</a>
			
		</div>

	</main>

</body>
</html>